{
  "name": "behind-the-price",
  "version": "0.1.0",
  "private": true,
  "description": "Automated video-production engine for the Behind the Price YouTube channel.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render:test": "remotion render TestComposition output/test.mp4",
    "still:test": "remotion still TestComposition output/test-frame.png --frame=45",
    "typecheck": "tsc",
    "upgrade": "remotion upgrade",
    "render:costco-proof": "remotion render Episode output/costco-proof.mp4 --props=./episodes/001-costco-receipt/proof.json"
  },
  "dependencies": {
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
